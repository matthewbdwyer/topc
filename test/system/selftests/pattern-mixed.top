// Pair(_, y) should bind y to the SECOND payload (offset 2), not the first.
type Expr = Unit | Lit(n) | Pair(a, b);

tag(e) {
  var r;
  r = 0;
  case e of {
    Unit       -> r = 0;
    Lit(x)     -> r = x;
    Pair(_, y) -> r = y;
  }
  return r;
}

main() {
  if (tag(Unit) != 0) error tag(Unit);
  if (tag(Lit(7)) != 7) error tag(Lit(7));
  if (tag(Pair(3, 5)) != 5) error tag(Pair(3,5));
  return 0;
}
