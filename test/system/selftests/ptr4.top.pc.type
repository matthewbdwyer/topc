
[type-constraints]
  [type] - ⟦((*p)+1)@3:7⟧ = int
  [type] - ⟦((*x)!=43)@11:6⟧ = int
  [type] - ⟦((*x)!=43)@11:6⟧ = int
  [type] - ⟦(*p)@3:7⟧ = int
  [type] - ⟦(*x)@11:22⟧ = int
  [type] - ⟦(*x)@11:6⟧ = ⟦43@11:12⟧
  [type] - ⟦0@12:9⟧ = int
  [type] - ⟦0@12:9⟧ = int
  [type] - ⟦1@3:12⟧ = int
  [type] - ⟦1@3:12⟧ = int
  [type] - ⟦42@9:12⟧ = int
  [type] - ⟦43@11:12⟧ = int
  [type] - ⟦alloc 42@9:6⟧ = ⭡⟦42@9:12⟧
  [type] - ⟦increment@2:0⟧ = (⟦p@2:10⟧) -> ⟦p@2:10⟧
  [type] - ⟦increment@2:0⟧ = (⟦x@8:6⟧) -> ⟦increment(x)@10:6⟧
  [type] - ⟦main@7:0⟧ = () -> ⟦0@12:9⟧
  [type] - ⟦p@2:10⟧ = ⭡⟦((*p)+1)@3:7⟧
  [type] - ⟦p@2:10⟧ = ⭡⟦(*p)@3:2⟧
  [type] - ⟦p@2:10⟧ = ⭡⟦(*p)@3:7⟧
  [type] - ⟦x@8:6⟧ = ⟦alloc 42@9:6⟧
  [type] - ⟦x@8:6⟧ = ⟦increment(x)@10:6⟧
  [type] - ⟦x@8:6⟧ = ⭡⟦(*x)@11:22⟧
  [type] - ⟦x@8:6⟧ = ⭡⟦(*x)@11:6⟧

[type-schemes]
  [scheme] - increment : (⭡int) -> ⭡int
  [scheme] - main : () -> int

[type-instantiations]
  [inst] 10:6 call increment(x) instantiates increment

[type-inferred]
  [inferred] - function increment : (⭡int) -> ⭡int
  [inferred] 2:10 local increment.p : ⭡int
  [inferred] - function main : () -> int
  [inferred] 8:6 local main.x : ⭡int
