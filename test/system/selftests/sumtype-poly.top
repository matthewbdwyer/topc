type Result = Ok(val) | Err(code);

getOrDefault(r, def) {
  var v;
  v = def;
  case r of {
    Ok(x)  -> v = x;
    Err(c) -> v = def;
  }
  return v;
}

main() {
  var a, b;
  a = getOrDefault(Ok(42), 0);
  b = getOrDefault(Err(1), 99);
  if (a != 42) error a;
  if (b != 99) error b;
  return 0;
}
