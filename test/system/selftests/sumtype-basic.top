type Direction = North | South | East | West;

toInt(d) {
  var n;
  n = 0;
  case d of {
    North -> n = 1;
    South -> n = 2;
    East  -> n = 3;
    West  -> n = 4;
  }
  return n;
}

main() {
  var sum;
  sum = toInt(North) + toInt(South) + toInt(East) + toInt(West);
  if (sum != 10) error sum;
  return 0;
}
