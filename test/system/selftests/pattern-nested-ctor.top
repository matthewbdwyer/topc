// Tests nested constructor patterns with variable binding.
// x and y are extracted from the inner Lit / Neg payload and used in the body.
type Inner = Lit(n) | Neg(x);
type Outer = Empty | Wrap(inner);

innerVal(o) {
  var r;
  r = 0;
  case o of {
    Empty        -> r = 0;
    Wrap(Lit(x)) -> r = x;
    Wrap(Neg(y)) -> r = 0 - y;
  }
  return r;
}

main() {
  if (innerVal(Empty) != 0) error innerVal(Empty);
  if (innerVal(Wrap(Lit(5))) != 5) error innerVal(Wrap(Lit(5)));
  if (innerVal(Wrap(Neg(3))) != -3) error innerVal(Wrap(Neg(3)));
  return 0;
}
