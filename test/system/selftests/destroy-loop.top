// Each helper call allocates a value; the destruction pass frees it before
// the helper returns.  No memory is live between iterations.
helper(n) {
  var p, v;
  p = alloc n;
  v = *p;
  return v;
}

main() {
  var i, total;
  i = 0;
  total = 0;
  while (5 > i) {
    total = total + helper(i);
    i = i + 1;
  }
  if (total != 10) error total;
  return 0;
}
