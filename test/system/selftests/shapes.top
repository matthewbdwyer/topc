type Shape = Circle(r) | Rect(w, h) | Point;

area(s) {
  var a;
  a = 0;
  case s of {
    Circle(r) -> a = r * r;
    Rect(w, h) -> a = w * h;
    Point -> a = 0;
  }
  return a;
}

main() {
  if (area(Point) != 0) error area(Point);
  if (area(Rect(3,4)) != 12) error area(Rect(3,4));
  if (area(Circle(5)) != 25) error area(Circle(5));
  if (area(Circle(area(Circle(2)))) != 16) error area(Circle(area(Circle(2))));
  return 0;
}
