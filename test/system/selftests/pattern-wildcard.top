// The wildcard matches any value and binds nothing.
type Variants = None | Some(val) | Several(variant, value, variant);

isPresent(x) {
  var r;
  r = 0;
  case x of {
    None    -> r = 0;
    Some(_) -> r = 1;
    Several(_,vi,_) -> r = 2;
  }
  return r;
}

main() {
  if (isPresent(None) != 0) error isPresent(None);
  if (isPresent(Some(42)) != 1) error isPresent(Some(42));
  if (isPresent(Several(None,42,Some(42))) != 2) error isPresent(Several(None,42,Some(42)));
  return 0;
}
