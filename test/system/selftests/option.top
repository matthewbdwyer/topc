type Option = Some(x) | None;

unwrapOr(opt, def) {
  var result;
  result = def;
  case opt of {
    Some(v) -> result = v;
    None -> result = def;
  }
  return result;
}

main() {
  var x;

  x = unwrapOr(None, 42);
  if (x != 42) error x;

  x = unwrapOr(Some(23), 42);
  if (x != 23) error x;

  return 0;
}
