type Inner = Lit(n) | Neg(x);
type Outer = Empty | Wrap(inner);
getN(o) 
{
  var r;
  r = 0;
  case o of {
    Empty -> r = 0;
    Wrap(Lit(n)) -> r = n;
  }
  return r;
}

main() 
{
  return getN(Empty);
}

