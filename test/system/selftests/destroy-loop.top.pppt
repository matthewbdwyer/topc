helper(n) 
{
  var p, v;
  p = alloc n;
  v = *p;
  return v;
}

main() 
{
  var i, total;
  i = 0;
  total = 0;
  while ((5 > i)) 
    {
      total = (total + helper(i));
      i = (i + 1);
    }
  return (total - 10);
}

