// soundness grid case int.seq.borrow.consume
// kind=int context=seq op1=borrow op2=consume
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return p + 1; }
look(q) { return *q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = 5;
  r = r + look(&x);
  r = r + consume(x);
