// soundness grid case int.cond.consume.ident
// kind=int context=cond op1=consume op2=ident
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consume(p) { return p + 1; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = 5;
  i = 0;
  while (consume(x) > i) { i = i + 1000; }
  y = ident(x);
  return 0;
}
