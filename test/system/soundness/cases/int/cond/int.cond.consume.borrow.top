// soundness grid case int.cond.consume.borrow
// kind=int context=cond op1=consume op2=borrow
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return p + 1; }
look(q) { return *q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = 5;
  i = 0;
  while (consume(x) > i) { i = i + 1000; }
  r = r + look(&x);
  return 0;
}
