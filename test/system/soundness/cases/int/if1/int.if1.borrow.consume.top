// soundness grid case int.if1.borrow.consume
// kind=int context=if1 op1=borrow op2=consume
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return p + 1; }
look(q) { return *q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = 5;
  if (c > 0) { r = r + look(&x); }
  r = r + consume(x);
  return 0;
}
