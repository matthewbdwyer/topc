// soundness grid case int.loop.ident.consume
// kind=int context=loop op1=ident op2=consume
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consume(p) { return p + 1; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = 5;
  i = 2;
  while (i > 0) { y = ident(x); i = i - 1; }
  r = r + consume(x);
  return 0;
}
