// soundness grid case int.loop.consume.ident
// kind=int context=loop op1=consume op2=ident
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consume(p) { return p + 1; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = 5;
  i = 2;
  while (i > 0) { r = r + consume(x); i = i - 1; }
  y = ident(x);
  return 0;
}
