// soundness grid case int.expr.consume.borrow
// kind=int context=expr op1=consume op2=borrow
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return p + 1; }
look(q) { return *q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = 5;
  r = r + consume(x) + look(&x);
  return 0;
}
