// soundness grid case int.arm1.assign.consume
// kind=int context=arm1 op1=assign op2=consume
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return p + 1; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = 5;
  sel = On(1);
  case sel of { On(k) -> { y = x; } Off -> r = r + 0; }
  r = r + consume(x);
  return 0;
}
