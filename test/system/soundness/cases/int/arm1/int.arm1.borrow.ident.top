// soundness grid case int.arm1.borrow.ident
// kind=int context=arm1 op1=borrow op2=ident
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
look(q) { return *q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = 5;
  sel = On(1);
  case sel of { On(k) -> { r = r + look(&x); } Off -> r = r + 0; }
  y = ident(x);
  return 0;
}
