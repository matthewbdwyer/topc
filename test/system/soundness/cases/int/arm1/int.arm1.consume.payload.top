// soundness grid case int.arm1.consume.payload
// kind=int context=arm1 op1=consume op2=payload
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return p + 1; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = 5;
  sel = On(1);
  case sel of { On(k) -> { r = r + consume(x); } Off -> r = r + 0; }
  w = Wrap(x);
  return 0;
}
