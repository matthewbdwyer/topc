// soundness grid case sumown.arm1.ident.borroww
// kind=sumown context=arm1 op1=ident op2=borroww
// expect: reject (ownership state disagreement at control-flow join)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
lookw(q) { var t; t = 0; case *q of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  sel = On(1);
  case sel of { On(k) -> { y = ident(x); } Off -> r = r + 0; }
  r = r + lookw(&x);
  return 0;
}
