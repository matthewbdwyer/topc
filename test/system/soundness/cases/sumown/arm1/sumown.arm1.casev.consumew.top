// soundness grid case sumown.arm1.casev.consumew
// kind=sumown context=arm1 op1=casev op2=consumew
// expect: reject (ownership state disagreement at control-flow join)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consumew(p) { var t; t = 0; case p of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  sel = On(1);
  case sel of { On(k) -> { case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } } Off -> r = r + 0; }
  r = r + consumew(x);
  return 0;
}
