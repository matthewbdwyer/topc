// soundness grid case sumown.arm1.ident.casev
// kind=sumown context=arm1 op1=ident op2=casev
// expect: reject (ownership state disagreement at control-flow join)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  sel = On(1);
  case sel of { On(k) -> { y = ident(x); } Off -> r = r + 0; }
  case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; }
  return 0;
}
