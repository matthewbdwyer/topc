// soundness grid case sumown.call.borroww.borrow
// kind=sumown context=call op1=borroww op2=borrow
// expect: accept
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
lookw(q) { var t; t = 0; case *q of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
pair(a1, a2) { return lookw(a1) + look(a2); }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  r = r + pair(&x, &x);
  return 0;
}
