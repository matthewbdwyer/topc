// soundness grid case sumown.call.borrow.consume
// kind=sumown context=call op1=borrow op2=consume
// expect: reject (borrows it; a borrowed owner must stay alive)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
pair(a1, a2) { return look(a1) + consume(a2); }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  r = r + pair(&x, x);
  return 0;
}
