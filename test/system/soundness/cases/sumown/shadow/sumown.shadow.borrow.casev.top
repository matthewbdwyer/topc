// soundness grid case sumown.shadow.borrow.casev
// kind=sumown context=shadow op1=borrow op2=casev
// expect: accept
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  y = Full(alloc 9);
  case y of { Full(v) -> { r = r + look(&x); case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } r = r + *v; } Empty -> { r = r + look(&x); case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } } }
  return 0;
}
