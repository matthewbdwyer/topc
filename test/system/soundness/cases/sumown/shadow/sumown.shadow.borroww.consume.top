// soundness grid case sumown.shadow.borroww.consume
// kind=sumown context=shadow op1=borroww op2=consume
// expect: accept
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
lookw(q) { var t; t = 0; case *q of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  y = Full(alloc 9);
  case y of { Full(v) -> { r = r + lookw(&x); r = r + consume(x); r = r + *v; } Empty -> { r = r + lookw(&x); r = r + consume(x); } }
  return 0;
}
