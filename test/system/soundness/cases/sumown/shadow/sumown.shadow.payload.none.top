// soundness grid case sumown.shadow.payload.none
// kind=sumown context=shadow op1=payload op2=none
// expect: accept
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  y = Full(alloc 9);
  case y of { Full(v) -> { w = Wrap(x);  r = r + *v; } Empty -> { w = Wrap(x);  } }
  return 0;
}
