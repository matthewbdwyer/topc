// soundness grid case sumown.shadow.consume.borrow
// kind=sumown context=shadow op1=consume op2=borrow
// expect: reject (used after move | moved more than once | assigned while still owned)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  y = Full(alloc 9);
  case y of { Full(v) -> { r = r + consume(x); r = r + look(&x); r = r + *v; } Empty -> { r = r + consume(x); r = r + look(&x); } }
  return 0;
}
