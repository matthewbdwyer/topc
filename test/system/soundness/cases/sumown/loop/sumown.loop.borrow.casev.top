// soundness grid case sumown.loop.borrow.casev
// kind=sumown context=loop op1=borrow op2=casev
// expect: accept
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 2;
  while (i > 0) { r = r + look(&x); i = i - 1; }
  case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; }
  return 0;
}
