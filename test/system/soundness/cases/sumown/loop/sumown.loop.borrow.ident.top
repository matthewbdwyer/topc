// soundness grid case sumown.loop.borrow.ident
// kind=sumown context=loop op1=borrow op2=ident
// expect: accept
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 2;
  while (i > 0) { r = r + look(&x); i = i - 1; }
  y = ident(x);
  return 0;
}
