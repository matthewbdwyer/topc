// soundness grid case sumown.loop.payload.casev
// kind=sumown context=loop op1=payload op2=casev
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 2;
  while (i > 0) { w = Wrap(x); i = i - 1; }
  case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; }
  return 0;
}
