// soundness grid case sumown.loop.casev.consumew
// kind=sumown context=loop op1=casev op2=consumew
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consumew(p) { var t; t = 0; case p of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 2;
  while (i > 0) { case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } i = i - 1; }
  r = r + consumew(x);
  return 0;
}
