// soundness grid case sumown.loop.ident.borrow
// kind=sumown context=loop op1=ident op2=borrow
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 2;
  while (i > 0) { y = ident(x); i = i - 1; }
  r = r + look(&x);
  return 0;
}
