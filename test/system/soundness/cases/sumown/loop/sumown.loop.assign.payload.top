// soundness grid case sumown.loop.assign.payload
// kind=sumown context=loop op1=assign op2=payload
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 2;
  while (i > 0) { y = x; i = i - 1; }
  w = Wrap(x);
  return 0;
}
