// soundness grid case sumown.cond.consumew.none
// kind=sumown context=cond op1=consumew op2=none
// expect: reject (move in while-loop condition)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consumew(p) { var t; t = 0; case p of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 0;
  while (consumew(x) > i) { i = i + 1000; }
  
  return 0;
}
