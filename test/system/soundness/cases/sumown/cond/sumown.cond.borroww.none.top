// soundness grid case sumown.cond.borroww.none
// kind=sumown context=cond op1=borroww op2=none
// expect: accept
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
lookw(q) { var t; t = 0; case *q of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 0;
  while (lookw(&x) > i) { i = i + 1000; }
  
  return 0;
}
