// soundness grid case sumown.cond.consume.borrow
// kind=sumown context=cond op1=consume op2=borrow
// expect: reject (move in while-loop condition)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 0;
  while (consume(x) > i) { i = i + 1000; }
  r = r + look(&x);
  return 0;
}
