// soundness grid case sumown.expr.consumew.consume
// kind=sumown context=expr op1=consumew op2=consume
// expect: reject (used after move | moved more than once | assigned while still owned)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
consumew(p) { var t; t = 0; case p of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  r = r + consumew(x) + consume(x);
  return 0;
}
