// soundness grid case sumown.if2.ident.none
// kind=sumown context=if2 op1=ident op2=none
// expect: accept
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { y = ident(x); } else { y = ident(x); }
  
  return 0;
}
