// soundness grid case sumown.if2.casev.borrow
// kind=sumown context=if2 op1=casev op2=borrow
// expect: reject (used after move | moved more than once | assigned while still owned)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } } else { case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } }
  r = r + look(&x);
  return 0;
}
