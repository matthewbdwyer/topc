// soundness grid case sumown.if2.casev.none
// kind=sumown context=if2 op1=casev op2=none
// expect: accept
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } } else { case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } }
  
  return 0;
}
