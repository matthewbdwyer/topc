// soundness grid case sumown.if2.payload.payload
// kind=sumown context=if2 op1=payload op2=payload
// expect: reject (used after move | moved more than once | assigned while still owned)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { w = Wrap(x); } else { w = Wrap(x); }
  w = Wrap(x);
  return 0;
}
