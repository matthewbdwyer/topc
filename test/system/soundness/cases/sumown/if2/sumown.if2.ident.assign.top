// soundness grid case sumown.if2.ident.assign
// kind=sumown context=if2 op1=ident op2=assign
// expect: reject (used after move | moved more than once | assigned while still owned)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { y = ident(x); } else { y = ident(x); }
  y = x;
  return 0;
}
