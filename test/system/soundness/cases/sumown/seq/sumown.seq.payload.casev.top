// soundness grid case sumown.seq.payload.casev
// kind=sumown context=seq op1=payload op2=casev
// expect: reject (used after move | moved more than once | assigned while still owned)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  w = Wrap(x);
  case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; }
  return 0;
}
