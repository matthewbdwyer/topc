// soundness grid case sumown.if1.consume.casev
// kind=sumown context=if1 op1=consume op2=casev
// expect: reject (ownership state disagreement at control-flow join)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { r = r + consume(x); }
  case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; }
  return 0;
}
