// soundness grid case sumown.if1.borrow.consume
// kind=sumown context=if1 op1=borrow op2=consume
// expect: accept
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { r = r + look(&x); }
  r = r + consume(x);
  return 0;
}
