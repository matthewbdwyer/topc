// soundness grid case sumown.if1.casev.borroww
// kind=sumown context=if1 op1=casev op2=borroww
// expect: reject (ownership state disagreement at control-flow join)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
lookw(q) { var t; t = 0; case *q of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } }
  r = r + lookw(&x);
  return 0;
}
