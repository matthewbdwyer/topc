// soundness grid case sum.seq.casev.consume
// kind=sum context=seq op1=casev op2=consume
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  case x of { Val(n) -> r = r + n; Nope -> r = r + 0; }
  r = r + consume(x);
  return 0;
}
