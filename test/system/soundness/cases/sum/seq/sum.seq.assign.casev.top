// soundness grid case sum.seq.assign.casev
// kind=sum context=seq op1=assign op2=casev
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  y = x;
  case x of { Val(n) -> r = r + n; Nope -> r = r + 0; }
  return 0;
}
