// soundness grid case sum.seq.borroww.borroww
// kind=sum context=seq op1=borroww op2=borroww
// expect: accept
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
lookw(q) { var t; t = 0; case *q of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  r = r + lookw(&x);
  r = r + lookw(&x);
  return 0;
}
