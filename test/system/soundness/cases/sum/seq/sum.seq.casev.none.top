// soundness grid case sum.seq.casev.none
// kind=sum context=seq op1=casev op2=none
// expect: accept
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  case x of { Val(n) -> r = r + n; Nope -> r = r + 0; }
  
  return 0;
}
