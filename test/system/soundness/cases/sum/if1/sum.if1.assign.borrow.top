// soundness grid case sum.if1.assign.borrow
// kind=sum context=if1 op1=assign op2=borrow
// expect: reject (ownership state disagreement at control-flow join)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { y = x; }
  r = r + look(&x);
  return 0;
}
