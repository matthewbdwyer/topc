// soundness grid case sum.if1.borroww.assign
// kind=sum context=if1 op1=borroww op2=assign
// expect: accept
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
lookw(q) { var t; t = 0; case *q of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { r = r + lookw(&x); }
  y = x;
  return 0;
}
