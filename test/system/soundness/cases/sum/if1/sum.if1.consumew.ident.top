// soundness grid case sum.if1.consumew.ident
// kind=sum context=if1 op1=consumew op2=ident
// expect: reject (ownership state disagreement at control-flow join)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consumew(p) { var t; t = 0; case p of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { r = r + consumew(x); }
  y = ident(x);
  return 0;
}
