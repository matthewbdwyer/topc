// soundness grid case sum.if1.payload.consume
// kind=sum context=if1 op1=payload op2=consume
// expect: reject (ownership state disagreement at control-flow join)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { w = Wrap(x); }
  r = r + consume(x);
  return 0;
}
