// soundness grid case sum.if1.assign.casev
// kind=sum context=if1 op1=assign op2=casev
// expect: reject (ownership state disagreement at control-flow join)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { y = x; }
  case x of { Val(n) -> r = r + n; Nope -> r = r + 0; }
  return 0;
}
