// soundness grid case sum.shadow.casev.consumew
// kind=sum context=shadow op1=casev op2=consumew
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consumew(p) { var t; t = 0; case p of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  y = Val(9);
  case y of { Val(n) -> { case x of { Val(n) -> r = r + n; Nope -> r = r + 0; } r = r + consumew(x); r = r + n; } Nope -> { case x of { Val(n) -> r = r + n; Nope -> r = r + 0; } r = r + consumew(x); } }
  return 0;
}
