// soundness grid case sum.shadow.consumew.none
// kind=sum context=shadow op1=consumew op2=none
// expect: accept
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consumew(p) { var t; t = 0; case p of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  y = Val(9);
  case y of { Val(n) -> { r = r + consumew(x);  r = r + n; } Nope -> { r = r + consumew(x);  } }
  return 0;
}
