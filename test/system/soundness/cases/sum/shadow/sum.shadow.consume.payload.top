// soundness grid case sum.shadow.consume.payload
// kind=sum context=shadow op1=consume op2=payload
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  y = Val(9);
  case y of { Val(n) -> { r = r + consume(x); w = Wrap(x); r = r + n; } Nope -> { r = r + consume(x); w = Wrap(x); } }
  return 0;
}
