// soundness grid case sum.shadow.casev.borrow
// kind=sum context=shadow op1=casev op2=borrow
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  y = Val(9);
  case y of { Val(n) -> { case x of { Val(n) -> r = r + n; Nope -> r = r + 0; } r = r + look(&x); r = r + n; } Nope -> { case x of { Val(n) -> r = r + n; Nope -> r = r + 0; } r = r + look(&x); } }
  return 0;
}
