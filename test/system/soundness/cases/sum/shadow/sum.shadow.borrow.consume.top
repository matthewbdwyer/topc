// soundness grid case sum.shadow.borrow.consume
// kind=sum context=shadow op1=borrow op2=consume
// expect: accept
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
look(q) { var t; t = 0; case *q of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  y = Val(9);
  case y of { Val(n) -> { r = r + look(&x); r = r + consume(x); r = r + n; } Nope -> { r = r + look(&x); r = r + consume(x); } }
  return 0;
}
