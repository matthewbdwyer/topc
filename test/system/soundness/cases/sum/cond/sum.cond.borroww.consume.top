// soundness grid case sum.cond.borroww.consume
// kind=sum context=cond op1=borroww op2=consume
// expect: accept
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
lookw(q) { var t; t = 0; case *q of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 0;
  while (lookw(&x) > i) { i = i + 1000; }
  r = r + consume(x);
  return 0;
}
