// soundness grid case sum.cond.consume.borrow
// kind=sum context=cond op1=consume op2=borrow
// expect: reject (move in while-loop condition)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
look(q) { var t; t = 0; case *q of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 0;
  while (consume(x) > i) { i = i + 1000; }
  r = r + look(&x);
  return 0;
}
