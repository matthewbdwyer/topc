// soundness grid case sum.cond.consumew.casev
// kind=sum context=cond op1=consumew op2=casev
// expect: reject (move in while-loop condition)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consumew(p) { var t; t = 0; case p of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 0;
  while (consumew(x) > i) { i = i + 1000; }
  case x of { Val(n) -> r = r + n; Nope -> r = r + 0; }
  return 0;
}
