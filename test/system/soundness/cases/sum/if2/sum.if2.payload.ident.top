// soundness grid case sum.if2.payload.ident
// kind=sum context=if2 op1=payload op2=ident
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { w = Wrap(x); } else { w = Wrap(x); }
  y = ident(x);
  return 0;
}
