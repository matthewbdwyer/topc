// soundness grid case sum.if2.casev.payload
// kind=sum context=if2 op1=casev op2=payload
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { case x of { Val(n) -> r = r + n; Nope -> r = r + 0; } } else { case x of { Val(n) -> r = r + n; Nope -> r = r + 0; } }
  w = Wrap(x);
  return 0;
}
