// soundness grid case sum.if2.ident.borrow
// kind=sum context=if2 op1=ident op2=borrow
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
look(q) { var t; t = 0; case *q of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { y = ident(x); } else { y = ident(x); }
  r = r + look(&x);
  return 0;
}
