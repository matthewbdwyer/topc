// soundness grid case sum.if2.consumew.assign
// kind=sum context=if2 op1=consumew op2=assign
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consumew(p) { var t; t = 0; case p of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { r = r + consumew(x); } else { r = r + consumew(x); }
  y = x;
  return 0;
}
