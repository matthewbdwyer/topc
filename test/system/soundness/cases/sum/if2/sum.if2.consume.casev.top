// soundness grid case sum.if2.consume.casev
// kind=sum context=if2 op1=consume op2=casev
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { r = r + consume(x); } else { r = r + consume(x); }
  case x of { Val(n) -> r = r + n; Nope -> r = r + 0; }
  return 0;
}
