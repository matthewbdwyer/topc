// soundness grid case sum.if2.ident.assign
// kind=sum context=if2 op1=ident op2=assign
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { y = ident(x); } else { y = ident(x); }
  y = x;
  return 0;
}
