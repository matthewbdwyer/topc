// soundness grid case sum.if2.consume.ident
// kind=sum context=if2 op1=consume op2=ident
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { r = r + consume(x); } else { r = r + consume(x); }
  y = ident(x);
  return 0;
}
