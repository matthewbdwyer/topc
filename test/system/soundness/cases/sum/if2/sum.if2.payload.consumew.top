// soundness grid case sum.if2.payload.consumew
// kind=sum context=if2 op1=payload op2=consumew
// expect: reject (used after move | moved more than once | assigned while still owned)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consumew(p) { var t; t = 0; case p of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { w = Wrap(x); } else { w = Wrap(x); }
  r = r + consumew(x);
  return 0;
}
