// soundness grid case sum.gen.pass.lend
// kind=sum context=gen op1=pass op2=lend
// expect: reject (which uses it again after passing it on)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
look(q) { var t; t = 0; case *q of { Val(n) -> t = n; Nope -> t = 0; } return t; }
gen(f, g, z) { var t; t = 0; t = t + f(z); t = t + g(&z); return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  r = r + gen(consume, look, x);
  return 0;
}
