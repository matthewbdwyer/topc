// soundness grid case sum.arm1.ident.payload
// kind=sum context=arm1 op1=ident op2=payload
// expect: reject (ownership state disagreement at control-flow join)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  sel = On(1);
  case sel of { On(k) -> { y = ident(x); } Off -> r = r + 0; }
  w = Wrap(x);
  return 0;
}
