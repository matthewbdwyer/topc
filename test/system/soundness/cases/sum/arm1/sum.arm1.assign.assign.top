// soundness grid case sum.arm1.assign.assign
// kind=sum context=arm1 op1=assign op2=assign
// expect: reject (ownership state disagreement at control-flow join)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  sel = On(1);
  case sel of { On(k) -> { y = x; } Off -> r = r + 0; }
  y = x;
  return 0;
}
