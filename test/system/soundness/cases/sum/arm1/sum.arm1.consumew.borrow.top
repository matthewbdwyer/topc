// soundness grid case sum.arm1.consumew.borrow
// kind=sum context=arm1 op1=consumew op2=borrow
// expect: reject (ownership state disagreement at control-flow join)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Val(n) -> t = n; Nope -> t = 0; } return t; }
consumew(p) { var t; t = 0; case p of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  sel = On(1);
  case sel of { On(k) -> { r = r + consumew(x); } Off -> r = r + 0; }
  r = r + look(&x);
  return 0;
}
