// soundness grid case sum.arm1.consume.consume
// kind=sum context=arm1 op1=consume op2=consume
// expect: reject (ownership state disagreement at control-flow join)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  sel = On(1);
  case sel of { On(k) -> { r = r + consume(x); } Off -> r = r + 0; }
  r = r + consume(x);
  return 0;
}
