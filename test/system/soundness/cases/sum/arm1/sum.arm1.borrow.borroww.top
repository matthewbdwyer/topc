// soundness grid case sum.arm1.borrow.borroww
// kind=sum context=arm1 op1=borrow op2=borroww
// expect: accept
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Val(n) -> t = n; Nope -> t = 0; } return t; }
lookw(q) { var t; t = 0; case *q of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  sel = On(1);
  case sel of { On(k) -> { r = r + look(&x); } Off -> r = r + 0; }
  r = r + lookw(&x);
  return 0;
}
