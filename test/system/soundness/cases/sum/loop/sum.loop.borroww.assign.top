// soundness grid case sum.loop.borroww.assign
// kind=sum context=loop op1=borroww op2=assign
// expect: accept
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
lookw(q) { var t; t = 0; case *q of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 2;
  while (i > 0) { r = r + lookw(&x); i = i - 1; }
  y = x;
  return 0;
}
