// soundness grid case sum.loop.assign.ident
// kind=sum context=loop op1=assign op2=ident
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 2;
  while (i > 0) { y = x; i = i - 1; }
  y = ident(x);
  return 0;
}
