// soundness grid case sum.loop.ident.borroww
// kind=sum context=loop op1=ident op2=borroww
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
lookw(q) { var t; t = 0; case *q of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 2;
  while (i > 0) { y = ident(x); i = i - 1; }
  r = r + lookw(&x);
  return 0;
}
