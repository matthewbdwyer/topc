// soundness grid case sum.loop.consume.casev
// kind=sum context=loop op1=consume op2=casev
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 2;
  while (i > 0) { r = r + consume(x); i = i - 1; }
  case x of { Val(n) -> r = r + n; Nope -> r = r + 0; }
  return 0;
}
