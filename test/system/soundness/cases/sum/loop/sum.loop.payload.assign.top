// soundness grid case sum.loop.payload.assign
// kind=sum context=loop op1=payload op2=assign
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 2;
  while (i > 0) { w = Wrap(x); i = i - 1; }
  y = x;
  return 0;
}
