// soundness grid case own.loop.consume.ident
// kind=own context=loop op1=consume op2=ident
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 2;
  while (i > 0) { r = r + consume(x); i = i - 1; }
  y = ident(x);
  return 0;
}
