// soundness grid case own.loop.ident.write
// kind=own context=loop op1=ident op2=write
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 2;
  while (i > 0) { y = ident(x); i = i - 1; }
  *x = 3;
  return 0;
}
