// soundness grid case own.loop.borrow.consume
// kind=own context=loop op1=borrow op2=consume
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
look(q) { return **q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 2;
  while (i > 0) { r = r + look(&x); i = i - 1; }
  r = r + consume(x);
  return 0;
}
