// soundness grid case own.loop.assign.borrow
// kind=own context=loop op1=assign op2=borrow
// expect: reject (move inside while-loop body | still owned at the end of a while-loop)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 2;
  while (i > 0) { y = x; i = i - 1; }
  r = r + look(&x);
  return 0;
}
