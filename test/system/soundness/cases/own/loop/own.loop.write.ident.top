// soundness grid case own.loop.write.ident
// kind=own context=loop op1=write op2=ident
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 2;
  while (i > 0) { *x = 3; i = i - 1; }
  y = ident(x);
  return 0;
}
