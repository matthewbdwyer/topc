// soundness grid case own.loop.temp.ident
// kind=own context=loop op1=temp op2=ident
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 2;
  while (i > 0) { r = r + *make(); i = i - 1; }
  y = ident(x);
  return 0;
}
