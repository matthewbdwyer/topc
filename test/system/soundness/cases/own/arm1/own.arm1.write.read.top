// soundness grid case own.arm1.write.read
// kind=own context=arm1 op1=write op2=read
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  sel = On(1);
  case sel of { On(k) -> { *x = 3; } Off -> r = r + 0; }
  r = r + *x;
  return 0;
}
