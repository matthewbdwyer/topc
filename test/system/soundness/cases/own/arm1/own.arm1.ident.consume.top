// soundness grid case own.arm1.ident.consume
// kind=own context=arm1 op1=ident op2=consume
// expect: reject (ownership state disagreement at control-flow join)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  sel = On(1);
  case sel of { On(k) -> { y = ident(x); } Off -> r = r + 0; }
  r = r + consume(x);
  return 0;
}
