// soundness grid case own.arm1.write.temp
// kind=own context=arm1 op1=write op2=temp
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  sel = On(1);
  case sel of { On(k) -> { *x = 3; } Off -> r = r + 0; }
  r = r + *make();
  return 0;
}
