// soundness grid case own.arm1.read.none
// kind=own context=arm1 op1=read op2=none
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  sel = On(1);
  case sel of { On(k) -> { r = r + *x; } Off -> r = r + 0; }
  
  return 0;
}
