// soundness grid case own.arm1.consume.write
// kind=own context=arm1 op1=consume op2=write
// expect: reject (ownership state disagreement at control-flow join)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  sel = On(1);
  case sel of { On(k) -> { r = r + consume(x); } Off -> r = r + 0; }
  *x = 3;
  return 0;
}
