// soundness grid case own.call.consume.read
// kind=own context=call op1=consume op2=read
// expect: reject (used after move | moved more than once)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
pair(a1, a2) { return consume(a1) + a2; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + pair(x, *x);
  return 0;
}
