// soundness grid case own.call.borrow.temp
// kind=own context=call op1=borrow op2=temp
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
make() { var p; p = alloc 7; return p; }
pair(a1, a2) { return look(a1) + a2; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + pair(&x, *make());
  return 0;
}
