// soundness grid case own.call.consume.borrow
// kind=own context=call op1=consume op2=borrow
// expect: reject (borrows it; a borrowed owner must stay alive)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
look(q) { return **q; }
pair(a1, a2) { return consume(a1) + look(a2); }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + pair(x, &x);
  return 0;
}
