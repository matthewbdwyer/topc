// soundness grid case own.call.temp.borrow
// kind=own context=call op1=temp op2=borrow
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
make() { var p; p = alloc 7; return p; }
pair(a1, a2) { return a1 + look(a2); }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + pair(*make(), &x);
  return 0;
}
