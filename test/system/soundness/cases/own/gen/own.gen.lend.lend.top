// soundness grid case own.gen.lend.lend
// kind=own context=gen op1=lend op2=lend
// expect: reject (neither returned nor borrowed nor passed on)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
look(q) { return **q; }
gen(f, g, z) { var t; t = 0; t = t + g(&z); t = t + g(&z); return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + gen(consume, look, x);
  return 0;
}
