// soundness grid case own.cond.consume.ident
// kind=own context=cond op1=consume op2=ident
// expect: reject (move in while-loop condition)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 0;
  while (consume(x) > i) { i = i + 1000; }
  y = ident(x);
  return 0;
}
