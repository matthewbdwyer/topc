// soundness grid case own.cond.read.borrow
// kind=own context=cond op1=read op2=borrow
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 0;
  while (*x > i) { i = i + 1000; }
  r = r + look(&x);
  return 0;
}
