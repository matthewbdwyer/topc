// soundness grid case own.cond.read.temp
// kind=own context=cond op1=read op2=temp
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 0;
  while (*x > i) { i = i + 1000; }
  r = r + *make();
  return 0;
}
