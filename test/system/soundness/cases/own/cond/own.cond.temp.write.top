// soundness grid case own.cond.temp.write
// kind=own context=cond op1=temp op2=write
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 0;
  while (*make() > i) { i = i + 1000; }
  *x = 3;
  return 0;
}
