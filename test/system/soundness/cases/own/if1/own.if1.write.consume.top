// soundness grid case own.if1.write.consume
// kind=own context=if1 op1=write op2=consume
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { *x = 3; }
  r = r + consume(x);
  return 0;
}
