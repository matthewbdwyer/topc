// soundness grid case own.if1.ident.consume
// kind=own context=if1 op1=ident op2=consume
// expect: reject (ownership state disagreement at control-flow join)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { y = ident(x); }
  r = r + consume(x);
  return 0;
}
