// soundness grid case own.if1.consume.payload
// kind=own context=if1 op1=consume op2=payload
// expect: reject (ownership state disagreement at control-flow join)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + consume(x); }
  w = Wrap(x);
  return 0;
}
