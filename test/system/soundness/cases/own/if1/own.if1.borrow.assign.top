// soundness grid case own.if1.borrow.assign
// kind=own context=if1 op1=borrow op2=assign
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + look(&x); }
  y = x;
  return 0;
}
