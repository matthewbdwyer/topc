// soundness grid case own.if1.payload.temp
// kind=own context=if1 op1=payload op2=temp
// expect: reject (ownership state disagreement at control-flow join)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { w = Wrap(x); }
  r = r + *make();
  return 0;
}
