// soundness grid case own.if1.read.borrow
// kind=own context=if1 op1=read op2=borrow
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + *x; }
  r = r + look(&x);
  return 0;
}
