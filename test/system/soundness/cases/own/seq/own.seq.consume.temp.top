// soundness grid case own.seq.consume.temp
// kind=own context=seq op1=consume op2=temp
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + consume(x);
  r = r + *make();
  return 0;
}
