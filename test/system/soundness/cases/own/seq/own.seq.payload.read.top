// soundness grid case own.seq.payload.read
// kind=own context=seq op1=payload op2=read
// expect: reject (used after move | moved more than once | assigned while still owned)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  w = Wrap(x);
  r = r + *x;
  return 0;
}
