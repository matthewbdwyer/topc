// soundness grid case own.seq.assign.payload
// kind=own context=seq op1=assign op2=payload
// expect: reject (used after move | moved more than once | assigned while still owned)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  y = x;
  w = Wrap(x);
  return 0;
}
