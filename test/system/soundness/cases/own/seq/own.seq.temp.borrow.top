// soundness grid case own.seq.temp.borrow
// kind=own context=seq op1=temp op2=borrow
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + *make();
  r = r + look(&x);
  return 0;
}
