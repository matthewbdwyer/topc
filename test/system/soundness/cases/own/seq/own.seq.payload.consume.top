// soundness grid case own.seq.payload.consume
// kind=own context=seq op1=payload op2=consume
// expect: reject (used after move | moved more than once | assigned while still owned)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  w = Wrap(x);
  r = r + consume(x);
  return 0;
}
