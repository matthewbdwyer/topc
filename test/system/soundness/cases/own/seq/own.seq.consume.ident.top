// soundness grid case own.seq.consume.ident
// kind=own context=seq op1=consume op2=ident
// expect: reject (used after move | moved more than once | assigned while still owned)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + consume(x);
  y = ident(x);
  return 0;
}
