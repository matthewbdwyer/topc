// soundness grid case own.seq.borrow.temp
// kind=own context=seq op1=borrow op2=temp
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + look(&x);
  r = r + *make();
  return 0;
}
