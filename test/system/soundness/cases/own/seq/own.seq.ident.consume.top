// soundness grid case own.seq.ident.consume
// kind=own context=seq op1=ident op2=consume
// expect: reject (used after move | moved more than once | assigned while still owned)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  y = ident(x);
  r = r + consume(x);
  return 0;
}
