// soundness grid case own.if2.assign.borrow
// kind=own context=if2 op1=assign op2=borrow
// expect: reject (used after move | moved more than once | assigned while still owned)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { y = x; } else { y = x; }
  r = r + look(&x);
  return 0;
}
