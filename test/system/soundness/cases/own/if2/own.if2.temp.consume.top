// soundness grid case own.if2.temp.consume
// kind=own context=if2 op1=temp op2=consume
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + *make(); } else { r = r + *make(); }
  r = r + consume(x);
  return 0;
}
