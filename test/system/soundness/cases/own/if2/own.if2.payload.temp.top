// soundness grid case own.if2.payload.temp
// kind=own context=if2 op1=payload op2=temp
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { w = Wrap(x); } else { w = Wrap(x); }
  r = r + *make();
  return 0;
}
