// soundness grid case own.if2.payload.read
// kind=own context=if2 op1=payload op2=read
// expect: reject (used after move | moved more than once | assigned while still owned)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { w = Wrap(x); } else { w = Wrap(x); }
  r = r + *x;
  return 0;
}
