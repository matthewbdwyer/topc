// soundness grid case own.if2.ident.payload
// kind=own context=if2 op1=ident op2=payload
// expect: reject (used after move | moved more than once | assigned while still owned)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { y = ident(x); } else { y = ident(x); }
  w = Wrap(x);
  return 0;
}
