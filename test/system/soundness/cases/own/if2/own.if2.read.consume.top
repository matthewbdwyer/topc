// soundness grid case own.if2.read.consume
// kind=own context=if2 op1=read op2=consume
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + *x; } else { r = r + *x; }
  r = r + consume(x);
  return 0;
}
