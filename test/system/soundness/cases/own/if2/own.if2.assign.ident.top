// soundness grid case own.if2.assign.ident
// kind=own context=if2 op1=assign op2=ident
// expect: reject (used after move | moved more than once | assigned while still owned)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { y = x; } else { y = x; }
  y = ident(x);
  return 0;
}
