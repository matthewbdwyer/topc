// soundness grid case own.if2.borrow.consume
// kind=own context=if2 op1=borrow op2=consume
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
look(q) { return **q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + look(&x); } else { r = r + look(&x); }
  r = r + consume(x);
  return 0;
}
