// soundness grid case own.if2.ident.temp
// kind=own context=if2 op1=ident op2=temp
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { y = ident(x); } else { y = ident(x); }
  r = r + *make();
  return 0;
}
