// soundness grid case own.if2.write.borrow
// kind=own context=if2 op1=write op2=borrow
// expect: accept
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { *x = 3; } else { *x = 3; }
  r = r + look(&x);
  return 0;
}
