// f(n) = g(n) + 1 and g(n) = f(n) together say f(n) = f(n) + 1.  Neither
// calls itself, so the cycle must be found in the call graph.
spec f(n) {
  return g(n) + 1;
}

spec g(n) {
  return f(n);
}

liar(x)
  ensures result == 42
{
  assert f(0) == g(0) + 1;
  return 0;
}

main() {
  return liar(1);
}
