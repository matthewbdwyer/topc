// Higher-order recursive call with inconsistent borrow/own actuals: rejected
// by type unification after borrow expressions infer borrow references.
foo(p, x) {
    var f, q;
    if (*p == 0) {
        f = 1;
    } else {
        q = alloc 0;
        *q = (*p) - 1;
        f = (*p) * ((x)(q, x));
    }
    return f;
}

main() {
    var n;
    n = 7;
    if (5040 != foo(&n, foo)) error foo(&n, foo);
    return 0;
}