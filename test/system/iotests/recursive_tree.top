type Tree = Leaf | Node(val, left, right);

// Consuming insert: takes the tree by value (move), matches (which moves the
// subtrees out of the old node and frees its shell), and rebuilds.
insert(t, v) {
  var result;
  case t of {
    Leaf -> result = Node(v, Leaf, Leaf);
    Node(x, l, r) -> {
      if (v > x) {
        result = Node(x, l, insert(r, v));
      } else {
        if (x > v) {
          result = Node(x, insert(l, v), r);
        } else {
          result = Node(x, l, insert(r, v));
        }
      }
    }
  }
  return result;
}

// Consuming inorder traversal frees the tree as it goes.
inorder(t) {
  var dummy;
  case t of {
    Leaf -> { dummy = 0; }
    Node(v, l, r) -> {
      dummy = inorder(l);
      output v;
      dummy = inorder(r);
    }
  }
  return 0;
}

main() {
  var t, n, count, dummy;
  t = Leaf;
  count = 0;
  n = input;
  while (n != 0) {
    t = insert(t, n);
    count = count + 1;
    n = input;
  }
  dummy = inorder(t);
  return count;
}
