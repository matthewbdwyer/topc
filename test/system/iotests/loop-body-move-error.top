// A while body may not change which variables are owned. Moving `a` inside
// the loop would free it on the first iteration and use it again on the
// second; destruction has no runtime flag to tell the iterations apart.
sink(p) { return *p; }

main() {
  var a, i, r;
  a = alloc 1;
  i = 2;
  r = 0;
  while (i > 0) {
    r = r + sink(a);
    i = i - 1;
  }
  return r;
}
