// A requirement on a generic callee follows a local copy of a formal back to
// that formal. `take` moves an owned value out of the borrow when the referent
// is Own; `f` passes it a local copy of its formal, so `f` inherits the
// requirement, and the call `f(&box)` with an owned referent is rejected.
take(p) { return *p; }

f(q) {
  var z;
  z = q;
  return take(z);
}

main() {
  var box, r;
  box = alloc 3;
  r = f(&box);
  return 0;
}
