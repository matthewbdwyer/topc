// Integer square root: nonlinear arithmetic, and a postcondition that pins
// the answer down exactly.
isqrt(n)
  requires n >= 0
  ensures result * result <= n
  ensures n < (result + 1) * (result + 1)
{
  var r;
  r = 0;
  while ((r + 1) * (r + 1) <= n)
    invariant r >= 0
    invariant r * r <= n
  {
    r = r + 1;
  }
  return r;
}

main() {
  var s;
  s = isqrt(50);
  assert s == 7;
  return s;
}
